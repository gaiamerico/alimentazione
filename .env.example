# Copia in .env e inserisci i valori del tuo progetto Supabase
# (Dashboard → Project Settings → API). La chiave anon/publishable è pubblica per design:
# la sicurezza dei dati è garantita dalle policy RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Solo per scripts/import-usda.mjs (mai nel frontend!)
SUPABASE_SERVICE_ROLE_KEY=
FDC_API_KEY=DEMO_KEY
