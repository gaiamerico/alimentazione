# Copia in .env e inserisci i valori del tuo progetto Supabase
# (Dashboard → Project Settings → API). La chiave anon/publishable è pubblica per design:
# la sicurezza dei dati è garantita dalle policy RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Solo per gli script in scripts/ (import-usda, review-candidates): mai nel frontend!
SUPABASE_SERVICE_ROLE_KEY=
FDC_API_KEY=DEMO_KEY

# L'assistente (Edge Function resolve-food) NON legge questo file: le sue chiavi sono
# secrets di Supabase. Impostale una volta con:
#   npx supabase secrets set GEMINI_API_KEY=... TAVILY_API_KEY=... FDC_API_KEY=...
# (chiave Gemini da aistudio.google.com, in alternativa il nome GOOGLE_API_KEY; chiave Tavily da app.tavily.com, per la ricerca web)
# Opzionali: GEMINI_MODEL (default gemini-3.5-flash-lite), GEMINI_THINKING_BUDGET (-1 dinamico · 0 spento · n token; default -1),
#   FOOD_AGENT_DAILY_LIMIT (default 5), OFF_USER_AGENT (lookup-barcode, es. "NutriOssalati/1.0 (contatto)")
